# Takeboard 环境变量样例 —— 复制成 .env 再填值（.env 已被 .gitignore 忽略，不会入库）
#
# 优先级：环境变量 > data/llm.json（设置面板存的）> 项目根 .env
# 也就是说面板里存过值之后，这里的同名变量会把它盖掉，面板会黄字提醒「改动不生效」。

# ── LLM · 助手（OpenAI 兼容端点）────────────────────────────
# 任何 OpenAI 兼容网关都行，baseUrl 记得带 /v1
TAKEBOARD_LLM_BASE_URL=
TAKEBOARD_LLM_API_KEY=
TAKEBOARD_LLM_MODEL=
# 下面三项留空 = 用内置默认
TAKEBOARD_LLM_TEMPERATURE=
TAKEBOARD_LLM_MAX_TOKENS=
TAKEBOARD_LLM_TIMEOUT_MS=
# 网关要额外请求头时给一段 JSON，例如 {"x-some":"v"}
TAKEBOARD_LLM_HEADERS=

# 也认 OpenAI 官方那套变量名（TAKEBOARD_LLM_* 优先）
# OPENAI_BASE_URL=
# OPENAI_API_BASE=
# OPENAI_API_KEY=
# OPENAI_MODEL=

# ── 服务与路径 ──────────────────────────────────────────────
# 服务端口，默认 4317
TAKEBOARD_PORT=
# 项目数据根目录，默认进程当前目录
TAKEBOARD_ROOT=
# CLI / 脚本访问服务用，默认 http://127.0.0.1:4317
TAKEBOARD_API=

# ── 外部依赖 ────────────────────────────────────────────────
# 不填就走 data/defaults.json 里的本机默认（设置面板「本机默认」那块能改）
TAKEBOARD_FFMPEG=
TAKEBOARD_FFPROBE=
# h3 视频提示词增强技能的目录，指到别处时才填
H3_SKILL_DIR=
